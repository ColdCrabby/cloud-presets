# Server
ADDR=:8080

# Stytch auth (required when enabling auth middleware)
STYTCH_PROJECT_ID=
# Test env only: point JWKS at test.stytch.com (default targets live api.stytch.com)
# STYTCH_JWKS_URL=https://test.stytch.com/v1/sessions/jwks/<project_id>
# Vendor app build var: baked into the browser bundle by `make build`.
# Public token (safe to ship), NOT the secret. Empty = sample sign-in.
STYTCH_PUBLIC_TOKEN=

# GitHub App bot (optional until vendor submissions are enabled)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_PRESETS_REPOSITORY=ColdCrabby/presets
GITHUB_API_BASE_URL=

# Set exactly one of these:
# - Inline PEM (or base64-encoded PEM)
GITHUB_APP_PRIVATE_KEY=
# - File path to PEM (mounted secret)
GITHUB_APP_PRIVATE_KEY_FILE=
