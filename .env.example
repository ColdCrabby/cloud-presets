# Server
ADDR=:8080

# Stytch B2B auth (required when enabling auth middleware)
STYTCH_PROJECT_ID=
STYTCH_ISSUER=
STYTCH_AUDIENCE=
STYTCH_JWKS_URL=
STYTCH_MAX_TOKEN_AGE=5m30s

# GitHub App bot (optional until vendor submissions are enabled)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_PRESETS_REPOSITORY=ColdCrabby/presets
GITHUB_API_BASE_URL=

# Set exactly one of these:
# - Inline PEM (or base64-encoded PEM)
GITHUB_APP_PRIVATE_KEY=
# - File path to PEM (mounted secret)
GITHUB_APP_PRIVATE_KEY_FILE=
